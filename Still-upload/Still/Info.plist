<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cocomedia.still.focus-links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>still</string>
			</array>
		</dict>
	</array>
	<!-- Ambient sound keeps playing when the screen locks during a session. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The session timer on the Lock Screen and in the Dynamic Island (StillWidgets). -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Permission prompts. Each is asked in context, never at launch. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Still shows your calendar events beside your tasks on the day timeline. It only reads them and never changes your calendar.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Still turns what you say into a task. Your voice isn't saved.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Still listens only while you're saying a task.</string>
	<key>NFCReaderUsageDescription</key>
	<string>Still writes a preset's link to your Focus Card.</string>
</dict>
</plist>
